{
  "name": "openapi-zod",
  "version": "0.3.0",
  "description": "Convert OpenAPI 3.x documents to Zod 4 validators and route metadata.",
  "license": "MIT",
  "author": "Justice O.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justiceo/openapi-zod.git"
  },
  "bugs": {
    "url": "https://github.com/justiceo/openapi-zod/issues"
  },
  "homepage": "https://github.com/justiceo/openapi-zod#readme",
  "keywords": ["openapi", "zod", "typescript", "codegen", "schema", "validation"],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "openapi-zod": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["CHANGELOG.md", "dist"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "bun run build && bun scripts/serve-demo.mjs",
    "format": "biome format --write .",
    "generate:fixtures": "bun scripts/generate-fixtures.mjs",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run build && bun test && bun run pack:dry-run",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.0.0",
    "knip": "^6.32.2",
    "typescript": "^5.8.3",
    "zod": "^4.1.12"
  }
}
