#!/usr/bin/env bash
# Pre-commit checks: lint, formatting, dead code, unit tests, and an AI
# review against .claude/review-guidelines.md. Installed via `bun install`
# (see the "prepare" script in package.json, which runs
# `git config core.hooksPath .githooks`).
set -e

echo "[pre-commit] Running lint..."
bun run lint

echo "[pre-commit] Checking formatting..."
bunx biome format .

echo "[pre-commit] Checking for dead code..."
bun run knip

echo "[pre-commit] Running unit tests..."
bun test

echo "[pre-commit] Running AI review..."
"$(dirname "$0")/ai-review.sh"

echo "[pre-commit] All checks passed."
